PINECONE_API_KEY=your_pinecone_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Native PostgreSQL or the optional docker-compose.yml service.
# URL-encode special characters in the username/password.
DATABASE_URL=postgresql+psycopg://clinician:clinician@localhost:5432/clinician
# Use a separate empty database for integration tests.
TEST_DATABASE_URL=postgresql+psycopg://clinician:clinician@localhost:5432/clinician_test

FRONTEND_URL=http://localhost:5173
SESSION_TTL_SECONDS=604800
VERIFY_EMAIL_TTL_SECONDS=86400
RESET_PASSWORD_TTL_SECONDS=1800

# file: development emails in backend/instance/mail/*.eml (ignored by Git).
# smtp: real delivery; set your provider's credentials and enable STARTTLS.
MAIL_BACKEND=file
MAIL_FROM=Clinician <noreply@clinician.local>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false

# Use a shared storage backend before running multiple application workers.
RATELIMIT_STORAGE_URI=memory://
