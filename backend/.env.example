PINECONE_API_KEY=your_pinecone_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Native PostgreSQL or the optional docker-compose.yml service.
# URL-encode special characters in the username/password.
DATABASE_URL=postgresql+psycopg://clinician:clinician@localhost:5432/clinician
DATABASE_AUTH_MODE=password
# Aurora Express: set DATABASE_AUTH_MODE=iam and use a URL without a password:
# DATABASE_URL=postgresql+psycopg://postgres@YOUR_RDS_ENDPOINT:5432/clinician
# AWS_REGION=ap-southeast-2
# Optional named AWS profile; otherwise use the standard AWS credential chain.
# AWS_PROFILE=clinician
# Express uses public root certificates (provided by certifi) by default.
# For standard RDS IAM connections, download the RDS CA bundle and set:
# DATABASE_SSL_ROOT_CERT=certs/global-bundle.pem
# Use a separate empty database for integration tests.
TEST_DATABASE_URL=postgresql+psycopg://clinician:clinician@localhost:5432/clinician_test

FRONTEND_URL=http://localhost:5173
SESSION_TTL_SECONDS=43200
VERIFY_EMAIL_TTL_SECONDS=86400
RESET_PASSWORD_TTL_SECONDS=1800

# file: development emails in backend/instance/mail/*.eml (ignored by Git).
# smtp: real delivery; set your provider's credentials and enable STARTTLS.
MAIL_BACKEND=file
MAIL_FROM=Clinician <noreply@clinician.local>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false

# Use a shared storage backend before running multiple application workers.
RATELIMIT_STORAGE_URI=memory://
